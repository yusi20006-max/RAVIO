# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_URL: Optional deployed backend URL baked into standalone mobile/APK builds
# so the APK connects to the server without requiring any API key on the device.
VITE_BACKEND_URL=""

# RAVIO_API_SECRET: Optional shared bearer secret to protect /api/gemini/* on public deployments.
# Leave empty in local development or private previews.
RAVIO_API_SECRET=""

# ALLOWED_ORIGINS: Optional comma-separated list of allowed CORS origins for the backend.
# Capacitor (https://localhost, capacitor://localhost) and same-origin requests are allowed automatically.
ALLOWED_ORIGINS=""

# GEMINI_API_KEY_FALLBACK / GEMINI_API_KEYS: Optional secondary Gemini API key(s) used automatically
# if GEMINI_API_KEY hits quota (429), auth failure, or temporary unavailability (503).
GEMINI_API_KEY_FALLBACK=""
GEMINI_API_KEYS=""

# OPENROUTER_API_KEY: Optional server-side OpenRouter Secret used as fallback for /api/gemini/script
# when all configured Gemini keys/models are unavailable or rate-limited.
OPENROUTER_API_KEY=""
OPENROUTER_FALLBACK_MODEL=""
