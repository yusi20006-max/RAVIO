<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ravio_widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Brand + Live Status Badge -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_widget_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txt_widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="راویو · رادیوی رانندگی"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ravio_widget_status_badge"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="آماده"
            android:textColor="#FACC15"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Category Selector (5 Direct-Tap Chips) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/btn_cat_combined"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/ravio_widget_chip_active"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="ترکیبی"
            android:textColor="#0B0D10"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cat_iran"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/ravio_widget_chip_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="ایران"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cat_world"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/ravio_widget_chip_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="جهان"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cat_economy"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/ravio_widget_chip_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="اقتصاد"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cat_tech"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/ravio_widget_chip_inactive"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="فناوری"
            android:textColor="#E4E4E7"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Headline / Current Broadcast Summary -->
    <TextView
        android:id="@+id/txt_widget_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="دسته را انتخاب کنید و «بساز و پخش کن» را بزنید"
        android:textColor="#D4D4D8"
        android:textSize="12sp" />

    <!-- Row 3: Oversized Driving Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/btn_build_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="3"
            android:background="@drawable/ravio_widget_build_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="⚡ بساز و پخش کن"
            android:textColor="#0B0D10"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_toggle_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/ravio_widget_play_idle_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="▶ پخش"
            android:textColor="#34D399"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
